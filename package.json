{
  "name": "inkvault",
  "productName": "InkVault",
  "version": "0.1.5",
  "description": "Bibliothèque comics & mangas — catalogue, stats et IA locale, en app desktop",
  "main": "electron/main.js",
  "author": "DmzGamingYT",
  "license": "MIT",
  "homepage": "https://github.com/DmzGamingYT/InkVault",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmzGamingYT/InkVault.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/js/app.js && node --check src/js/ai.js && node --check src/js/covers.js && node --check src/js/store.js && node --check electron/main.js && node --check electron/preload.js",
    "dist:linux": "electron-builder --linux AppImage tar.gz --publish never && ./scripts/make-deb.sh x64",
    "dist:linux:arm64": "electron-builder --linux AppImage tar.gz --arm64 --publish never && ./scripts/make-deb.sh arm64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dmzgamining.inkvault",
    "productName": "InkVault",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "DmzGamingYT",
      "repo": "InkVault"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "maintainer": "DmzGamingYT <DmzGamingYT@users.noreply.github.com>",
      "synopsis": "Bibliothèque comics & mangas avec IA locale",
      "desktop": {
        "Name": "InkVault",
        "Categories": "Office;Literature;"
      }
    },
    "appImage": {
      "artifactName": "InkVault-${version}-linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "inkvault-${version}-${arch}.deb"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
